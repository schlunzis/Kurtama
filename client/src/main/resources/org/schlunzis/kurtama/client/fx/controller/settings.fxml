<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.*?>
<GridPane xmlns:fx="http://javafx.com/fxml" xmlns="http://javafx.com/javafx"
          fx:controller="org.schlunzis.kurtama.client.fx.controller.SettingsController">
    <Button text="Delete Account" styleClass="secondary_button" GridPane.columnIndex="0" GridPane.rowIndex="0"
            GridPane.columnSpan="2" onAction="#deleteAccount"/>
    <Button text="Back" styleClass="secondary_button" GridPane.columnIndex="0" GridPane.rowIndex="1"
            GridPane.columnSpan="2" onAction="#back"/>
</GridPane>
